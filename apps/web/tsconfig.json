{
	"extends": "../../packages/typescript-config/nextjs.json",
	"compilerOptions": {
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*", "../../packages/ui/src/*"],
			"@sushiswap/ui": ["../../packages/ui/src"],
			"@sushiswap/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
